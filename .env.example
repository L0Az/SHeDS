STAGE=local
DB_NAME=sheds_db
DB_USER=sheds_user
DB_PASSWORD=sheds_password
DB_HOST=localhost
DB_PORT=55999
DB_TIMEOUT=30
CACHE_LOCATION=localhost:6379/1
CUSTOM_AWS_SECRET_ACCESS_KEY=
DJANGO_SETTINGS_MODULE=config.settings.local

# ── Passbolt ──────────────────────────────────────────────────────────────────
# Run once: ./scripts/generate_passbolt_keys.sh admin@your-domain.com

PASSBOLT_ADMIN_EMAIL=admin@your-domain.com
PASSBOLT_ADMIN_FIRST_NAME=Admin
PASSBOLT_ADMIN_LAST_NAME=User

PASSBOLT_BASE_URL=http://localhost:8080

PASSBOLT_GPG_FINGERPRINT=
PASSBOLT_GPG_PUBLIC_KEY=
PASSBOLT_GPG_PRIVATE_KEY=
PASSBOLT_GPG_PASSPHRASE=

# Set to false only when using self-signed TLS in development
PASSBOLT_VERIFY_SSL=true

# ── Passbolt DB (prod only — dev uses hardcoded values in docker-compose.yml) ─
PASSBOLT_DB_NAME=passbolt
PASSBOLT_DB_USER=passbolt
PASSBOLT_DB_PASSWORD=

# ── Passbolt email (prod only) ────────────────────────────────────────────────
PASSBOLT_EMAIL_FROM=passbolt@your-domain.com
PASSBOLT_SMTP_HOST=
PASSBOLT_SMTP_PORT=587
PASSBOLT_SMTP_USER=
PASSBOLT_SMTP_PASSWORD=

# ── Passbolt ports (prod only — dev uses 8080/8443) ──────────────────────────
PASSBOLT_HTTP_PORT=8080
PASSBOLT_HTTPS_PORT=8443

# ══════════════════════════════════════════════════════════════════════════════
#  SHeDS — Environment Variables
#
#  For production:
#    1. cp .env.example .env
#    2. Fill in every value below
#    3. docker compose -f docker-compose.prod.yml up -d
#
#  For local development:
#    Copy relevant keys into backend/.env (with DB_HOST=localhost, etc.)
# ══════════════════════════════════════════════════════════════════════════════

# ── Site ──────────────────────────────────────────────────────────────────────
# Public domain (no protocol, no trailing slash).
# Caddy uses this to obtain a TLS certificate via Let's Encrypt automatically.
DOMAIN=helpdesk.example.com

# ── Django ────────────────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=change-me-to-a-long-random-string

# ── Database ──────────────────────────────────────────────────────────────────
DB_NAME=sheds_db
DB_USER=sheds_user
DB_PASSWORD=change-me-strong-db-password
DB_TIMEOUT=30

# ── Email (SMTP) ──────────────────────────────────────────────────────────────
# OCI Email Delivery endpoint: OCI Console → Email Delivery → Configuration
EMAIL_HOST=smtp.email.<region>.oci.oraclecloud.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
# OCI Console → top-right profile → User Settings → SMTP Credentials → Generate
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=noreply@example.com

# ── OCI Object Storage ────────────────────────────────────────────────────────
# Required for file uploads and static asset serving in production.
# OCI Console → top-right profile → Tenancy → OCID
OCI_TENANCY_OCID=ocid1.tenancy.oc1..
# OCI Console → top-right profile → User Settings → OCID
OCI_USER_OCID=ocid1.user.oc1..
# OCI Console → User Settings → API Keys → Add API Key → fingerprint shown after creation
OCI_KEY_FINGERPRINT=xx:xx:xx:xx:xx:xx:xx:xx:xx:xx:xx:xx:xx:xx:xx:xx
# Recommended: mount the .pem file and set the path here
OCI_KEY_FILE=
# Alternative: paste the private key content as a single line (escape newlines as \n)
OCI_PRIVATE_KEY=
OCI_KEY_PASSPHRASE=
# OCI Console → top-right region selector (e.g. sa-vinhedo-1, eu-frankfurt-1)
OCI_REGION=sa-vinhedo-1
# OCI Console → Storage → Object Storage → top of Buckets page
OCI_NAMESPACE=
OCI_BUCKET_NAME=sheds-bucket
# Optional: custom CDN domain for the bucket (leave blank to use OCI default URL)
OCI_CUSTOM_DOMAIN=

# ── Sentry (optional, for error tracking) ─────────────────────────────────────
SENTRY_DSN_KEY=

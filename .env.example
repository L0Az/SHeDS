STAGE=local
DB_NAME=sheds_db
DB_USER=sheds_user
DB_PASSWORD=sheds_password
DB_HOST=localhost
DB_PORT=55999
DB_TIMEOUT=30
CACHE_LOCATION=localhost:6379/1
DJANGO_SETTINGS_MODULE=config.settings.local

# ── Django email (OCI Email Delivery via SMTP) ────────────────────────────────
# SMTP endpoint: Email Delivery → Configuration in the OCI console
EMAIL_HOST=smtp.email.<region>.oci.oraclecloud.com
EMAIL_PORT=587
EMAIL_USE_TLS=true
# top-right profile icon → User Settings → SMTP Credentials → Generate SMTP Credentials
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=noreply@your-domain.com

# ── OCI API credentials (Object Storage SDK + sender email) ──────────────────
# Tenancy OCID: top-right profile icon → Tenancy: <name> → Tenancy Information → OCID
OCI_TENANCY_OCID=ocid1.tenancy.oc1..
# User OCID: top-right profile icon → User Settings → User Information → OCID
OCI_USER_OCID=ocid1.user.oc1..
# API key: top-right profile icon → User Settings → API Keys → Add API Key
# Choose "Generate API Key Pair", download the .pem file, copy the fingerprint shown
OCI_KEY_FINGERPRINT=
# Path to the downloaded .pem file (recommended — avoids newline issues in .env)
OCI_KEY_FILE=./backend/oci_private_key.pem
# Alternative: paste key inline as a single line with literal \n between lines
# OCI_PRIVATE_KEY=-----BEGIN RSA PRIVATE KEY-----\nMII...\n-----END RSA PRIVATE KEY-----
# Region identifier shown in the top-right region selector, e.g. eu-frankfurt-1
OCI_REGION=
# Compartment OCID: hamburger menu → Identity & Security → Compartments → your compartment → OCID
OCI_COMPARTMENT_OCID=ocid1.compartment.oc1..
# Object Storage bucket for ticket attachments
OCI_BUCKET_NAME=
# Namespace: hamburger menu → Storage → Object Storage → top of the Buckets page
OCI_BUCKET_NAMESPACE=

OCI_SENDER_EMAIL=noreply@your-domain.com
